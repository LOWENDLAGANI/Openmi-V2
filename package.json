{
  "name": "openmi",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "worker": "bun --conditions=react-server worker/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:rls": "bun test tests/rls.test.ts tests/rls-audit.test.ts",
    "test:e2e": "playwright test",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "border-beam": "^1.4.1",
    "e2b": "^2.63.0",
    "gsap": "^3.15.1",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@playwright/test": "1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
