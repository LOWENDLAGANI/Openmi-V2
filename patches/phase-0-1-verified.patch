diff --git a/tests/limits-docs.test.ts b/tests/limits-docs.test.ts
new file mode 100644
index 0000000..d83932f
--- /dev/null
+++ b/tests/limits-docs.test.ts
@@ -0,0 +1,102 @@
+// ── Openmi — the documentation may not drift from the constants ──────────────
+//
+// The audit's cheapest finding was also its most corrosive: the README promised
+// "eight steps and 60k tokens, one flat Code charge per turn" while the code
+// enforced 40 steps, 200,000 tokens, and billed by the hour. A reader had no way
+// to tell which was true, and the pricing correction of 2026-10-28 fixed one half
+// of the sentence while leaving the other half wrong beside it.
+//
+// Prose cannot be typechecked, so this pins the numbers instead: the documents
+// must state the values the code exports. Raise `MAX_STEPS` and this fails until
+// the README says so — which is the only reliable way to keep a written budget
+// honest over time.
+//
+//   bunx tsx tests/limits-docs.test.ts
+
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { MAX_STEPS, MAX_TURN_TOKENS } from "../lib/agent/turns";
+import { DEW_PER_HOUR } from "../lib/dew";
+
+const README = readFileSync(join(process.cwd(), "README.md"), "utf8");
+const SPEC = readFileSync(join(process.cwd(), "docs/OVERHAUL_SPEC.md"), "utf8");
+
+/** 40 → "forty", so the README can spell a small budget out in prose. */
+const WORDS: Record<number, string> = {
+  8: "eight",
+  12: "twelve",
+  20: "twenty",
+  30: "thirty",
+  40: "forty",
+  50: "fifty",
+  60: "sixty",
+};
+
+function statesSteps(text: string): boolean {
+  const word = WORDS[MAX_STEPS];
+  return text.includes(`${MAX_STEPS} steps`) || (Boolean(word) && text.includes(`${word} steps`));
+}
+
+// ── The values that must appear ──────────────────────────────────────────────
+
+assert.ok(
+  statesSteps(README),
+  `README must state the step budget (${MAX_STEPS}) as "${MAX_STEPS} steps" or "${WORDS[MAX_STEPS]} steps"`
+);
+assert.ok(
+  README.includes(MAX_TURN_TOKENS.toLocaleString("en-US")),
+  `README must state the token budget as ${MAX_TURN_TOKENS.toLocaleString("en-US")}`
+);
+assert.ok(
+  SPEC.includes(`\`MAX_STEPS\` (${MAX_STEPS})`),
+  `docs/OVERHAUL_SPEC.md must state \`MAX_STEPS\` (${MAX_STEPS})`
+);
+assert.ok(
+  SPEC.includes(`\`MAX_TURN_TOKENS\` (${MAX_TURN_TOKENS.toLocaleString("en-US")})`),
+  `docs/OVERHAUL_SPEC.md must state \`MAX_TURN_TOKENS\` (${MAX_TURN_TOKENS.toLocaleString("en-US")})`
+);
+assert.ok(
+  SPEC.includes(`DEW_PER_HOUR = ${DEW_PER_HOUR}`),
+  `docs/OVERHAUL_SPEC.md must state DEW_PER_HOUR = ${DEW_PER_HOUR}`
+);
+
+// ── The claims that are no longer true ───────────────────────────────────────
+
+const STALE: Array<{ where: string; text: string; pattern: RegExp; why: string }> = [
+  {
+    where: "README.md",
+    text: README,
+    pattern: /eight steps|60k tokens|flat Code charge/i,
+    why: "the agent is 40 steps, 200,000 tokens, and an agent turn costs nothing beyond the hour",
+  },
+  {
+    where: "README.md",
+    text: README,
+    pattern: /flat (?:per[- ]request|per[- ]turn|charge)/i,
+    why: "billing is 3 Dew per hour, per model — there is no per-message or per-turn charge",
+  },
+  {
+    where: "docs/OVERHAUL_SPEC.md",
+    text: SPEC,
+    pattern: /flat per request|flat charge is deducted|flat 0\.5 Dew/i,
+    why: "billing is 3 Dew per hour, per model",
+  },
+  {
+    where: "docs/OVERHAUL_SPEC.md",
+    text: SPEC,
+    pattern: /step cap is 8|Twelve steps|\(8\) and|60k tokens/i,
+    why: "the step cap is 40 and the token budget is 200,000",
+  },
+];
+
+for (const claim of STALE) {
+  assert.ok(
+    !claim.pattern.test(claim.text),
+    `${claim.where} still claims "${claim.pattern.source}" — ${claim.why}`
+  );
+}
+
+console.log(
+  `  ok   documented limits match code: ${MAX_STEPS} steps, ${MAX_TURN_TOKENS.toLocaleString("en-US")} tokens, ${DEW_PER_HOUR} Dew/hour`
+);
diff --git a/tests/theme-literals.test.ts b/tests/theme-literals.test.ts
