index 0000000..b319a74
--- /dev/null
+++ b/tests/theme-literals.test.ts
@@ -0,0 +1,94 @@
+// ── Openmi — literal colours may only ever go down ───────────────────────────
+//
+// Paper and Ink are completed by an override block in `app/globals.css` that
+// rewrites literal Tailwind utilities (`text-white/60`, `bg-[#111a16]`). A
+// component added with a new literal is invisible to that block: it renders in
+// the dark palette while claiming to support three.
+//
+// The migration to semantic tokens happens in slices, so the thing that needs
+// pinning is the direction of travel. This is a ratchet: every file's count is
+// recorded in `scripts/theme-literals-baseline.json`, and a pull request fails
+// if any file gains one. Lowering a count is always allowed.
+//
+//   bunx tsx tests/theme-literals.test.ts            # check
+//   bunx tsx tests/theme-literals.test.ts --update   # re-record after a slice
+//
+// `--update` belongs in the same commit as the slice that lowered the numbers.
+// Running it to silence a regression defeats the test, which is why the total is
+// checked separately from the per-file counts: a literal moved from one file to
+// another is still a literal.
+
+import assert from "node:assert/strict";
+import { existsSync, readFileSync, readdirSync, writeFileSync } from "node:fs";
+import { join, relative, sep } from "node:path";
+
+const ROOT = process.cwd();
+const BASELINE = join(ROOT, "scripts", "theme-literals-baseline.json");
+
+/** Palette literals a component should express as a token instead. */
+const FORBIDDEN = [
+  /\b(?:text|bg|border|ring|from|via|to)-white\/\d+/g,
+  /\b(?:text|bg|border|ring)-black\/\d+/g,
+  /\b(?:text|bg|border|ring|from|via|to)-\[#[0-9a-fA-F]{3,8}\]/g,
+];
+
+function sources(dir: string): string[] {
+  const absolute = join(ROOT, dir);
+  if (!existsSync(absolute)) return [];
+  return readdirSync(absolute, { withFileTypes: true }).flatMap((entry) => {
+    const path = join(absolute, entry.name);
+    if (entry.isDirectory()) return sources(join(dir, entry.name));
+    return entry.name.endsWith(".tsx") ? [path] : [];
+  });
+}
+
+function count(file: string): number {
+  const text = readFileSync(file, "utf8");
+  return FORBIDDEN.reduce(
+    (total, pattern) => total + (text.match(pattern)?.length ?? 0),
+    0
+  );
+}
+
+const files = [...sources("components"), ...sources("app")].sort();
+const actual: Record<string, number> = {};
+for (const file of files) {
+  const key = relative(ROOT, file).split(sep).join("/");
+  actual[key] = count(file);
+}
+
+const withLiterals = Object.fromEntries(
+  Object.entries(actual).filter(([, value]) => value > 0)
+);
+
+if (process.argv.includes("--update")) {
+  writeFileSync(BASELINE, `${JSON.stringify(withLiterals, null, 2)}\n`, "utf8");
+  console.log(
+    `Recorded ${Object.keys(withLiterals).length} files, ${Object.values(withLiterals).reduce((a, b) => a + b, 0)} literals.`
+  );
+  process.exit(0);
+}
+
+assert.ok(existsSync(BASELINE), `missing ${BASELINE} — run with --update to record it`);
+const baseline = JSON.parse(readFileSync(BASELINE, "utf8")) as Record<string, number>;
+
+const regressions: string[] = [];
+for (const [file, value] of Object.entries(withLiterals)) {
+  const allowed = baseline[file] ?? 0;
+  if (value > allowed) regressions.push(`${file}: ${allowed} → ${value}`);
+}
+
+const before = Object.values(baseline).reduce((a, b) => a + b, 0);
+const now = Object.values(withLiterals).reduce((a, b) => a + b, 0);
+
+assert.deepEqual(
+  regressions,
+  [],
+  "literal palette utilities increased — use the semantic token instead:\n  " +
+    regressions.join("\n  ")
+);
+assert.ok(now <= before, `total literals rose from ${before} to ${now}`);
+
+console.log(
+  `  ok   literal colours: ${now} across ${Object.keys(withLiterals).length} files (was ${before})`
+);
