diff --git a/scripts/check-contrast.mjs b/scripts/check-contrast.mjs
new file mode 100644
index 0000000..954f456
--- /dev/null
+++ b/scripts/check-contrast.mjs
@@ -0,0 +1,149 @@
+#!/usr/bin/env node
+// ── Contrast, measured rather than asserted ──────────────────────────────────
+//
+// The audit's two hardest findings were both invisible in review and obvious to
+// a calculator: white ink on the sage accent measured 2.14:1, and the hint token
+// failed AA in all three palettes. Neither is a matter of taste, so neither
+// should be a matter of opinion in a pull request.
+//
+// This reads the three palettes out of `app/globals.css` — not a copy of them —
+// and computes WCAG 2.1 relative luminance over the exact shipped values. It
+// fails the build below the thresholds below.
+//
+//   node scripts/check-contrast.mjs
+//
+// Exits 0 when every pair passes, 1 when one does not. A pair whose tokens are
+// not defined in that palette is reported as skipped rather than passed, so a
+// token that quietly disappears is visible in the output.
+
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+
+const root = join(dirname(fileURLToPath(import.meta.url)), "..");
+const css = readFileSync(join(root, "app/globals.css"), "utf8");
+
+/** The body of a top-level block, brace-matched. */
+function blockBody(selector) {
+  const open = css.indexOf(`${selector} {`);
+  if (open === -1) return null;
+  let i = css.indexOf("{", open) + 1;
+  let depth = 1;
+  let body = "";
+  while (i < css.length && depth > 0) {
+    const ch = css[i];
+    if (ch === "{") depth += 1;
+    else if (ch === "}") depth -= 1;
+    if (depth > 0) body += ch;
+    i += 1;
+  }
+  return body;
+}
+
+/** Custom properties declared directly in a block. Nested blocks are ignored. */
+function declarations(body) {
+  const map = new Map();
+  if (!body) return map;
+  for (const match of body.matchAll(/--([a-z0-9-]+)\s*:\s*([^;]+);/gi)) {
+    map.set(`--${match[1]}`, match[2].trim());
+  }
+  return map;
+}
+
+function channels(hex) {
+  const value = hex.trim().replace(/^#/, "");
+  if (/^[0-9a-f]{3}$/i.test(value)) {
+    return [0, 1, 2].map((i) => parseInt(value[i] + value[i], 16));
+  }
+  if (/^[0-9a-f]{6}$/i.test(value)) {
+    return [0, 2, 4].map((i) => parseInt(value.slice(i, i + 2), 16));
+  }
+  return null;
+}
+
+function luminance(hex) {
+  const rgb = channels(hex);
+  if (!rgb) return null;
+  const [r, g, b] = rgb.map((c) => {
+    const s = c / 255;
+    return s <= 0.03928 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
+  });
+  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
+}
+
+function contrast(foreground, background) {
+  const a = luminance(foreground);
+  const b = luminance(background);
+  if (a === null || b === null) return null;
+  const [hi, lo] = a > b ? [a, b] : [b, a];
+  return (hi + 0.05) / (lo + 0.05);
+}
+
+const THEMES = [
+  { name: "dark", selector: ":root" },
+  { name: "paper", selector: "html.light" },
+  { name: "ink", selector: "html.ink" },
+];
+
+// `--bubble-user-text` is only redeclared where the bubble fill changes, so the
+// dark palette relies on the `var(..., #ffffff)` fallback in `.msg-user-bubble`.
+// Declaring it here mirrors what the stylesheet actually resolves to.
+const FALLBACKS = {
+  dark: { "--bubble-user-text": "#ffffff" },
+};
+
+const PAIRS = [
+  { fg: "--text-hi", bg: "--bg", min: 4.5, label: "heading" },
+  { fg: "--text", bg: "--bg", min: 4.5, label: "body" },
+  { fg: "--text-mid", bg: "--bg", min: 4.5, label: "secondary" },
+  { fg: "--text-low", bg: "--bg", min: 4.5, label: "hint" },
+  { fg: "--on-accent", bg: "--accent", min: 4.5, label: "ink on accent fill" },
+  // The accent doubles as a text colour and a UI border, which AA allows at 3:1
+  // for large text and non-text contrast. It cannot be raised without losing the
+  // identity, so this is the documented floor rather than an oversight.
+  { fg: "--accent", bg: "--bg", min: 3.0, label: "accent as text / UI" },
+  { fg: "--bubble-user-text", bg: "--bubble-user", min: 4.5, label: "user bubble" },
+];
+
+let failures = 0;
+let skips = 0;
+
+console.log("Contrast (WCAG 2.1) — app/globals.css\n");
+
+for (const theme of THEMES) {
+  const tokens = declarations(blockBody(theme.selector));
+  if (!tokens.size) {
+    console.log(`  FAIL ${theme.name}: palette not found at \`${theme.selector}\``);
+    failures += 1;
+    continue;
+  }
+  console.log(`  ${theme.name}`);
+  for (const pair of PAIRS) {
+    const fg = tokens.get(pair.fg) ?? FALLBACKS[theme.name]?.[pair.fg];
+    const bg = tokens.get(pair.bg) ?? FALLBACKS[theme.name]?.[pair.bg];
+    if (!fg || !bg || !channels(fg) || !channels(bg)) {
+      console.log(`    skip ${pair.label.padEnd(22)} ${pair.fg} / ${pair.bg} not a hex value`);
+      skips += 1;
+      continue;
+    }
+    const value = contrast(fg, bg);
+    const ok = value !== null && value >= pair.min;
+    if (!ok) failures += 1;
+    console.log(
+      `    ${ok ? "ok  " : "FAIL"} ${pair.label.padEnd(22)} ${value.toFixed(2)}:1  ` +
+        `(min ${pair.min.toFixed(1)})  ${fg} on ${bg}`
+    );
+  }
+}
+
+console.log(
+  `\n${failures === 0 ? "Pass" : "Fail"} — ${failures} below threshold, ${skips} skipped.`
+);
+
+if (failures > 0) {
+  console.log(
+    "\nFix the token, not the threshold. Paper's accent already shows the intended\n" +
+      "pairing: near-black ink (#15130f) on a saturated fill measures 5.37:1."
+  );
+  process.exit(1);
+}
