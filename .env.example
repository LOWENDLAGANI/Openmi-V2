# ── Openmi environment ───────────────────────────────────────────────────────
# Copy to .env.local for development. In production these are set per
# environment in Vercel (Preview and Production separately). Values never go in
# the repository, and a key that starts with NEXT_PUBLIC_ is compiled into the
# browser bundle — never put a secret there.
#
# Nothing here throws at boot. The app starts with an empty file and /setup
# reports exactly which of these is missing.

# Supabase — project URL and the browser-safe anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role. SERVER ONLY. Used for migrations and health probes,
# confined to lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# The origin this deployment is served from. Auth redirects and PR links use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32 random bytes, base64. Seals connected GitHub tokens with AES-256-GCM.
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_KEY=

# Optional — the admin panel's kill switch. Unset or blank means on: the normal
# rules (ADMIN_EMAILS, ADMIN_EMAIL_DOMAIN, admin_users) decide. Set to "off" and
# redeploy, and nobody is an admin on this deployment: the panel 404s, every
# admin action refuses, and no session, cookie, URL or database role outranks it.
# Postgres cannot read this variable, so the app mirrors it into public.admin_control
# and is_admin() reads that row: a stolen admin token calling the admin RPCs
# directly is refused too. Delete the compromised admin_users row as well once
# the incident is contained.
OPENMI_ADMIN_PANEL=

# Optional — when on, a ready diff is written to its own openmi/agent/ branch and
# its pull request opens without an approval click. The default branch is never
# written either way. Set to "off" to require the click on the review card.
OPENMI_AUTO_WRITE=on

# Optional — allow a change that names the default branch to be committed to it
# directly, without a pull request. Off by default and deliberately separate from
# OPENMI_AUTO_WRITE: skipping the click and rewriting main are different choices.
OPENMI_ALLOW_DEFAULT_BRANCH=off

# At least one AI provider key is required before chat can answer.
# OPENROUTER_API_KEY powers Auto: the fifty free UnoRouter models, tried in
# fitness order until one answers. Without it Auto is shown as unavailable.
# STRAITLY_API_KEY is tried first for the named DeepSeek model (deepseek-v4-1-flash-1017
# via https://api.straitly.ai/v1); if it fails, requests fall back to the direct DeepSeek
# provider below. Auto never uses either DeepSeek provider.
STRAITLY_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Optional — extra keys for the same provider and the same model. When the
# primary key is rejected or rate limited before the first token, the next key
# is tried; after a token has streamed nothing is retried. Two forms are read:
# a comma or space separated pool, then numbered variants _2 and _3.
STRAITLY_API_KEYS=
DEEPSEEK_API_KEYS=
OPENROUTER_API_KEYS=

# Optional — GitHub OAuth App connect flow. With both set, the workspace offers
# "Continue with GitHub" and the pasted token becomes the fallback. Create the
# OAuth App at GitHub → Settings → Developer settings → OAuth Apps and register
# <NEXT_PUBLIC_SITE_URL>/auth/github/callback as its callback URL. It asks for
# the `repo` scope, which is what reading code and opening a pull request need.
# The secret is server-only; never expose it to the browser.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional — operator access for the hidden admin panel (swipe up/down/left/
# right on the logo). Either an exact list or one verified Google Workspace
# domain. Server only; the email is compared against Supabase's getVerifiedUser.
ADMIN_EMAILS=
ADMIN_EMAIL_DOMAIN=

# Optional — hosted payment page for paid plans. Receipts are uploaded in-app
# and reviewed in /admin. Defaults to https://sociabuzz.com/minetallestmc/tribe
PAYMENT_LINK=

# Optional — pause real-money checkout. Open by default: with this unset (or set
# to "off") the payment link and receipt form are shown. Set to "on" to pause
# checkout and hide them while testing. A redeem code works either way, because
# no checkout is involved.
TOPUP_PAUSED=

# Optional — email the operator when a member uploads a receipt. The message
# carries the payer's address, the plan, the reference and the file as an
# attachment, and Reply-To is the payer. Without RESEND_API_KEY nothing is sent
# and the receipt still waits in /admin, so this is never a blocker.
RESEND_API_KEY=
# Where those notifications go. Defaults to the first address in ADMIN_EMAILS.
RECEIPT_NOTIFY_EMAIL=
# Sender line. Without a verified Resend domain, the default test sender only
# delivers to the Resend account owner's own address.
RECEIPT_FROM_EMAIL=

# Optional — extra models in the picker. Server only: the provider and
# upstream id never reach the browser, only the display name does. The provider
# must be openrouter or deepseek, and its key must be set. category is
# optional: general (default), coding or reasoning.
# [{"id":"my-model","name":"My Model","provider":"openrouter","upstream":"vendor/model-id","category":"coding"}]
CUSTOM_MODELS=

# Optional — Adsterra banner keys (browser-side by design). Until a key is
# set, each slot keeps its exact size and shows a labelled placeholder, so
# switching ads on never shifts the layout. Once any key is set, a browser
# whose ad blocker hides the bait is shown a blocking notice instead of the
# app; /setup and /admin stay reachable for operators, and with no keys the
# gate never engages.
NEXT_PUBLIC_ADSTERRA_LEADERBOARD_KEY=
NEXT_PUBLIC_ADSTERRA_MOBILE_KEY=
NEXT_PUBLIC_ADSTERRA_RECTANGLE_KEY=

# Optional — shared rate limiter. Without it, limiting falls back to Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional — sandbox verification. With no key the review card says execution is
# not configured and nothing runs; no other feature depends on it.
# Create an API key at https://e2b.dev (Dashboard → API keys). Sandboxes run as
# the template's `user`, with /home/user as the writable home the file API
# writes into.
E2B_API_KEY=

# Optional — a kill switch. Set to "off" to stop runs without removing the key.
EXECUTION_ENABLED=

# Optional — the live preview panel in a chat. On automatically when E2B_API_KEY
# is set; set to "off" to remove the panel and make the preview routes 404. The
# preview runs the repository's own dev script inside the chat's sandbox and
# serves it on the sandbox's public host, so anyone with the link can open it
# while it runs. The panel says so.
OPENMI_PREVIEW=

# Optional — versions of a chat's workspace. On automatically when E2B_API_KEY is
# set; "off" hides the panel. A version is a git commit inside the chat's sandbox
# clone, never a push: restoring moves the workspace back and leaves GitHub alone.
OPENMI_CHECKPOINTS=

# Optional — publishing a chat's app. Without a token the Publish button reports
# that publishing is not configured and deploys nothing. The token belongs to the
# operator, never to the reader: the server uses it with the reader's GitHub
# token to build the pinned branch's head. Set VERCEL_TEAM_ID to publish under a
# team instead of the account's personal scope.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Optional — the sandbox image runs start from. The default is E2B's `base`
# template, which carries node, npm and git. CPU and memory come from the
# template, so a repository that needs bun or pnpm baked in sets a custom image
# by name or id instead of installing it at boot. This repository installs with
# bun, so it needs a bun-bearing template; see docs/E2B_SANDBOX_READINESS.md.
EXECUTION_TEMPLATE=

# Optional — egress. "restricted" (the default) sends E2B's catch-all network
# pair: `allowOut: ['*']` with `denyOut: ['0.0.0.0/0']`, so an install reaches
# any host by name while raw IPs stay denied. "open" sends no policy; "off" has
# no network at all, so no install can run.
EXEC_NETWORK_MODE=

# Missions are the default whenever E2B_API_KEY is set: the agent decides
# and runs its own commands inside the sandbox. The sandbox holds no platform
# secret and cannot push to GitHub.
# Optional — minutes one mission may run, clamped to 1..30. Defaults to 20, and
# the Dew reserve is this number × 0.05.
EXEC_MISSION_MINUTES=

# Optional — chat-scoped sandboxes (Phase 12). Each chat keeps one workspace
# across messages: the container stops when the chat goes quiet (compute
# released, installed packages and files kept) and starts again on the next
# message. After CHAT_SANDBOX_TTL_HOURS of inactivity the container and its disk
# are destroyed. The contract is in docs/SANDBOX_LIFECYCLE_PLAN.md.
# Set to "off" to fall back to one fresh sandbox per message.
CHAT_SANDBOX_ENABLED=

# Optional — chat turns get the persistent Linux workspace by default: the
# sandbox handle is lazy, so a turn that never runs a command provisions nothing.
# Set this to "off" for GitHub-only turns (reads plus a proposed diff, no box).
# Verification runs and missions keep their own sandboxes either way. Activation
# checklist: docs/E2B_SANDBOX_READINESS.md.
OPENMI_SANDBOX_TURNS=on

# Optional — minutes of inactivity before the container stops. Default 5 (1..60).
CHAT_SANDBOX_IDLE_MINUTES=

# Optional — hours of inactivity before the container and its disk are
# destroyed. Default 48 (two days). Clamped to 1..168.
CHAT_SANDBOX_TTL_HOURS=

# Optional — kept for the environment contract. The sandbox provider has no
# archive tier: a parked workspace holds a snapshot, not a disk, and the
# provider reclaims a snapshot on its own retention schedule.
# The per-chat deadline is CHAT_SANDBOX_TTL_HOURS, enforced by the sweep.
CHAT_SANDBOX_ARCHIVE_HOURS=

# Optional — live chat sandboxes per account. Default 3; the oldest is evicted.
CHAT_SANDBOX_MAX_PER_OWNER=

# Required for the sweep to run. Vercel Cron sends it as `Authorization: Bearer`.
# The route refuses to run unauthenticated without it (503); the provider's own
# idle-stop and auto-delete timers still act as backstops. Generate a long
# random value, and do not reuse it for anything else.
CRON_SECRET=

# ── Web agent runs ───────────────────────────────────────────────────────────
# A run is executed by the worker, not by a request. Start it with
#   bun run worker
# and keep it on a machine that stays up. Nothing here is required to boot: a
# deployment without a worker still serves the app, and a queued run simply
# waits until one is running.

# Optional — how long one run may execute, clamped to 1..30. Default 15.
RUN_MAX_MINUTES=

# Optional — how many runs one worker process executes at once, clamped to 1..8.
# Default 2. The per-account limit (1 concurrent run) is separate and enforced
# when the run is queued.
RUN_WORKER_CONCURRENCY=

# Optional — where artifacts go. With none of these set, artifacts are written
# to RUN_ARTIFACT_DIR on the worker's own disk, which is only readable if the
# web app runs on the same host. Set the bucket for a worker on its own machine.
RUN_ARTIFACT_DIR=
RUN_ARTIFACTS_BUCKET=
# The S3-compatible endpoint, e.g. https://<account>.r2.cloudflarestorage.com
RUN_ARTIFACTS_ENDPOINT=
RUN_ARTIFACTS_REGION=auto
RUN_ARTIFACTS_ACCESS_KEY_ID=
RUN_ARTIFACTS_SECRET_ACCESS_KEY=

# Optional — when a run's sandbox pauses. Compute is released and the disk is
# kept, so a run costs memory for minutes and disk for days. Default 15 (1..60),
# the same ceiling as RUN_MAX_MINUTES.
RUN_SANDBOX_IDLE_MINUTES=

# Optional — how long a paused run workspace is kept before the sweep destroys
# it. Default 48 hours (1..168).
RUN_SANDBOX_TTL_HOURS=
