# ── Openmi environment ───────────────────────────────────────────────────────
# Copy to .env.local for development. In production these are set per
# environment in Vercel (Preview and Production separately). Values never go in
# the repository, and a key that starts with NEXT_PUBLIC_ is compiled into the
# browser bundle — never put a secret there.
#
# Nothing here throws at boot. The app starts with an empty file and /setup
# reports exactly which of these is missing.

# Supabase — project URL and the browser-safe anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role. SERVER ONLY. Used for migrations and health probes,
# confined to lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# The origin this deployment is served from. Auth redirects and PR links use it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 32 random bytes, base64. Seals connected GitHub tokens with AES-256-GCM.
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_KEY=

# At least one AI provider key is required before chat can answer.
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional — GitHub OAuth App connect flow (Phase 2, P2-T6).
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Optional — shared rate limiter. Without it, limiting falls back to Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
