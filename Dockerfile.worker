# The web-agent run worker, as a container.
#
# Render builds this with `docker build`. The process is a long-lived queue
# worker; when the host sets `PORT` it also answers `GET /healthz` on that port,
# which is what lets the same image run as a free Web Service with a health
# check. Without `PORT` (a VM, or a Background Worker) no port is opened.
# Nothing is compiled: Bun runs the TypeScript directly and resolves the `@/*`
# paths from tsconfig.json.
#
# Only the worker's own graph is copied — `worker/`, `lib/`, the lockfile and
# the tsconfig. The Next app is not in this image, which is the point: agent work
# does not run beside the web server.

FROM oven/bun:1-slim

WORKDIR /app

ENV NODE_ENV=production \
    BUN_INSTALL_CACHE_DIR=/tmp/bun-cache

# Supabase, GitHub and E2B are all HTTPS; a slim image without the CA bundle
# would fail the first fetch rather than the first build.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Dependencies first, so a source change does not re-install them.
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY tsconfig.json ./
COPY lib ./lib
COPY worker ./worker

# `react-server` makes the `server-only` marker resolve for this server process;
# without it those modules throw at import time.
CMD ["bun", "--conditions=react-server", "worker/main.ts"]
